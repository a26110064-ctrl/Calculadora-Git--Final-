#include <stdio.h>

int main()
{

int opcion;

float num1,num2,resultado;


printf("CALCULADORA\n");

printf("1. Suma\n");
printf("2. Resta\n");
printf("3. Multiplicacion\n");
printf("4. Division\n");


printf("Seleccione opcion: ");
scanf("%d",&opcion);


printf("Ingrese numero 1: ");
scanf("%f",&num1);


printf("Ingrese numero 2: ");
scanf("%f",&num2);

switch(opcion)
{

case 1:

resultado=num1+num2;

printf("Resultado %.2f",resultado);

break;


case 2:

resultado=num1-num2;

printf("Resultado %.2f",resultado);

break;


case 3:

resultado=num1*num2;

printf("Resultado %.2f",resultado);

break;


case 4:

if(num2!=0)
{

resultado=num1/num2;

printf("Resultado %.2f",resultado);

}

else
{

printf("Error division cero");

}

break;


}

return 0;

}
